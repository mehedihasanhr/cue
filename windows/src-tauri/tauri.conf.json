{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klik",
  "version": "0.2.1",
  "identifier": "com.stackrover.klik",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Md. Mehedi Hasan Hridoy",
    "shortDescription": "Screenshots, annotated in a click",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2N0ZGOUZFREMxNjNDMjMKUldRalBCYmMvdmwvRnJKdG9pNnJSNzBFWHhPbHNhRFdUdHk1ZUhnZUhuOEQ0MU5yK2tYbFZhNVkK",
      "endpoints": [
        "https://github.com/mehedihasanhr/klik-releases/releases/download/windows-feed/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}