{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cue Studio",
  "version": "0.1.0",
  "identifier": "com.stackrover.cue.studio",
  "build": {
    "beforeDevCommand": "pnpm -C .. studio:dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm -C .. studio:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$VIDEO/**", "$HOME/**"] }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "Md. Mehedi Hasan Hridoy",
    "shortDescription": "Screen recordings that look edited",
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["cue-studio"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2N0ZGOUZFREMxNjNDMjMKUldRalBCYmMvdmwvRnJKdG9pNnJSNzBFWHhPbHNhRFdUdHk1ZUhnZUhuOEQ0MU5yK2tYbFZhNVkK",
      "endpoints": ["https://github.com/mehedihasanhr/cue-releases/releases/download/studio-windows-feed/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
