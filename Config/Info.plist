<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist: only what the INFOPLIST_KEY_ settings cannot say. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.stackrover.cue</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cue</string>
			</array>
		</dict>
	</array>
	<!-- Cue's video recordings: packages it owns and opens in the video editor. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Cue Recording</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.stackrover.cue.recording</string>
			</array>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.stackrover.cue.recording</string>
			<key>UTTypeDescription</key>
			<string>Cue Recording</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cuerec</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- The Google OAuth client for Drive backup, from Config/Google.xcconfig. Empty when unset. -->
	<key>CueGoogleClientID</key>
	<string>$(CUE_GOOGLE_CLIENT_ID)</string>
	<!-- Sparkle updates: the feed lives in the public releases repository, under a fixed tag that
	     Scripts/publish-release.sh rewrites on every release. Each update is checked against this key
	     before it is installed; the private half is in the publisher's keychain (account "cue"). -->
	<key>SUFeedURL</key>
	<string>https://github.com/mehedihasanhr/cue-releases/releases/download/mac-feed/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>CZg8DWytPz8tuaxRXeelv1SM6zQICBGR3saGwy2Pilg=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<!-- Cue is sandboxed, so it cannot replace itself: Sparkle's installer launcher does it. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Cue writes captions by recognising the speech in your recording. This happens on your Mac — the audio is never sent anywhere.</string>
</dict>
</plist>
